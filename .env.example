# BAM Studios Contact Worker — Environment Variables
#
# These are NOT committed. Set them via:
#   - Cloudflare Dashboard → Worker → Settings → Variables and Secrets
#   - Or via wrangler: `wrangler secret put RESEND_API_KEY`

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
ALLOWED_ORIGIN=https://bam-studios-website.pages.dev
RECIPIENT_EMAIL=your-email@gmail.com
